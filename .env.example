# Copy to .env and set all three secrets. Never commit .env.
DB_PASSWORD=replace-with-a-random-local-database-password
# Generate base64 of 32 random bytes: see README / scripts/configure.ps1.
DATA_ENCRYPTION_KEY=
DEMO_PASSWORD=
DEMO_SEED=true
SIMULATION_CONTROLS=true
FILING_MODE=mock
COOKIE_SECURE=false
